{
  "info": {
    "name": "Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "refresh (cookie-based)",
          "request": {
            "method": "POST",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "auth", "refresh"]
            }
          }
        },
        {
          "name": "logout",
          "request": {
            "method": "POST",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "auth", "logout"]
            }
          }
        },
        {
          "name": "me",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Google",
      "item": [
        {
          "name": "login redirect",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "google"],
              "query": [
                {
                  "key": "state",
                  "value": "http://localhost:5173/auth/callback"
                }
              ]
            }
          }
        },
        {
          "name": "grant gmail redirect",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "google", "grant-gmail"],
              "query": [
                {
                  "key": "state",
                  "value": "http://localhost:5173/admin/integrations"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "roles[]",
                  "value": "",
                  "description": "student | lecture | admin",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"role\": \"student\",\n  \"isActive\": true\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "assignRole",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "users", "assignRole"]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "create",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"studentCode\": \"22120001\",\n  \"studentName\": \"Nguyen Van A\",\n  \"major\": \"Computer Science\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students"]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"studentName\": \"Nguyen Van A Updated\",\n  \"major\": \"Information Systems\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "import",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "studentCodeCol",
                  "type": "text",
                  "value": "1"
                },
                {
                  "key": "studentNameCol",
                  "type": "text",
                  "value": "2"
                },
                {
                  "key": "majorCol",
                  "type": "text",
                  "value": "3"
                },
                {
                  "key": "startRow",
                  "type": "text",
                  "value": "2"
                }
              ]
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "students", "import"]
            }
          }
        }
      ]
    }
  ]
}
