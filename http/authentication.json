{
  "info": {
    "name": "Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "role",
                  "value": "",
                  "description": "student | lecture | admin",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "users",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
              "raw": {
                "language": "json"
              }
            },
              "raw": "{\n    \"name\": \"Updated Name\",\n    \"role\": \"student\",\n    \"isActive\": true\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "users",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "assignRole",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
              "raw": {
                "language": "json"
              }
            },
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"role\": \"admin\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "users",
                "assignRole"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Google",
      "item": [
        {
          "name": "getAuthUrl",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "google"
              ]
            }
          }
        },
        {
          "name": "authenticate",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
              "raw": {
                "language": "json"
              }
            },
              "raw": "{\n    \"code\": \"<google_oauth_code>\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "google"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "refresh",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
              "raw": {
                "language": "json"
              }
            },
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "me",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    }
  ]
}
