{
    "info": {
        "name": "Class Registration",
        "description": "API collection for Class Registration module",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Class Registrations",
            "item": [
                {
                    "name": "Get All Registrations",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations?page=1&limit=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "keyword",
                                    "value": "",
                                    "description": "Search by studentCode, studentName, emailId",
                                    "disabled": true
                                },
                                {
                                    "key": "studentCode",
                                    "value": "",
                                    "description": "Filter by MSSV",
                                    "disabled": true
                                },
                                {
                                    "key": "academicYear",
                                    "value": "",
                                    "description": "Filter by academic year (khóa học)",
                                    "disabled": true
                                },
                                {
                                    "key": "status",
                                    "value": "PENDING",
                                    "description": "Filter by status: PENDING | APPROVED | REJECTED",
                                    "disabled": true
                                },
                                {
                                    "key": "action",
                                    "value": "REGISTER",
                                    "description": "Filter by action: REGISTER | CANCEL | REQUEST_OPEN",
                                    "disabled": true
                                },
                                {
                                    "key": "orderCol",
                                    "value": "id",
                                    "description": "Sort by: id | academicYear | sentAt | createdAt"
                                },
                                {
                                    "key": "orderDir",
                                    "value": "DESC",
                                    "description": "Sort direction: ASC | DESC"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Registrations by Priority",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/priority?page=1&limit=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", "priority"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "status",
                                    "value": "PENDING",
                                    "description": "Filter by status: PENDING | APPROVED | REJECTED",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Get registrations sorted by priority: 1. Academic Year (older first), 2. In Curriculum (true first), 3. Sent Date (earlier first)"
                    }
                },
                {
                    "name": "Get Registration by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", ":id"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Registration Details with Items",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/:id/details",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", ":id", "details"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Overview Stats",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/stats/overview",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", "stats", "overview"]
                        }
                    }
                },
                {
                    "name": "Get Open Request Stats",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/stats/open-requests",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", "stats", "open-requests"]
                        },
                        "description": "Statistics of subjects that students want to open"
                    }
                }
            ]
        },
        {
            "name": "Registration Items",
            "item": [
                {
                    "name": "Get Item by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/registration-items/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["registration-items", ":id"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Items by Registration ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/registration-items/by-registration/:registrationId",
                            "host": ["{{baseUrl}}"],
                            "path": ["registration-items", "by-registration", ":registrationId"],
                            "variable": [
                                {
                                    "key": "registrationId",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Process Item (Approve)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"APPROVED\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/registration-items/:id/process",
                            "host": ["{{baseUrl}}"],
                            "path": ["registration-items", ":id", "process"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Process Item (Reject)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"REJECTED\",\n    \"rejectReason\": \"Lớp đã đầy\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/registration-items/:id/process",
                            "host": ["{{baseUrl}}"],
                            "path": ["registration-items", ":id", "process"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Process Bulk Items",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"ids\": [1, 2, 3],\n    \"status\": {\n        \"status\": \"APPROVED\"\n    }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/registration-items/process-bulk",
                            "host": ["{{baseUrl}}"],
                            "path": ["registration-items", "process-bulk"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Cancel Reasons (Master Data)",
            "item": [
                {
                    "name": "Get All Cancel Reasons",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons?page=1&limit=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "isActive",
                                    "value": "true",
                                    "disabled": true
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Active Cancel Reasons (Dropdown)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons/active",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons", "active"]
                        },
                        "description": "Get all active cancel reasons for dropdown selection"
                    }
                },
                {
                    "name": "Get Cancel Reason by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons", ":id"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Cancel Reason",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"reasonText\": \"Lớp đã đầy\",\n    \"isActive\": true,\n    \"sortOrder\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons"]
                        }
                    }
                },
                {
                    "name": "Update Cancel Reason",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"reasonText\": \"Lớp đã đầy - Updated\",\n    \"isActive\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons", ":id"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Cancel Reason",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/cancel-reasons/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["cancel-reasons", ":id"],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Test Data",
            "item": [
                {
                    "name": "Create Test Registration (Manual)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"emailId\": \"test-email-001\",\n    \"studentCode\": \"20110001\",\n    \"academicYear\": 2020,\n    \"studentName\": \"Nguyễn Văn A\",\n    \"studentClass\": \"20110CL1\",\n    \"sentAt\": \"2026-01-29T10:00:00Z\",\n    \"items\": [\n        {\n            \"action\": \"REGISTER\",\n            \"subjectName\": \"Lập trình Web\",\n            \"className\": \"WEB01\",\n            \"subjectCode\": \"IT001\",\n            \"isInCurriculum\": true\n        },\n        {\n            \"action\": \"REGISTER\",\n            \"subjectName\": \"Cơ sở dữ liệu\",\n            \"className\": \"DB01\",\n            \"subjectCode\": \"IT002\",\n            \"isInCurriculum\": true\n        },\n        {\n            \"action\": \"REQUEST_OPEN\",\n            \"subjectName\": \"Machine Learning\",\n            \"isInCurriculum\": false\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/class-registrations/test-create",
                            "host": ["{{baseUrl}}"],
                            "path": ["class-registrations", "test-create"]
                        },
                        "description": "This endpoint needs to be added for testing purposes"
                    }
                }
            ]
        }
    ]
}
