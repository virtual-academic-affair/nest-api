            "body": {
              "mode": "raw",
              "raw": "{\n    \"studentCode\": \"2212000\",\n    \"studentName\": \"Nguyễn Văn A\",\n    \"academicYear\": 2025,\n    \"items\": [\n        {\n            \"action\": \"register\",\n            \"subjectName\": \"Toán cao cấp\",\n            \"subjectCode\": \"MATH101\",\n            \"className\": \"TH1\",\n            \"slotInfo\": \"Thứ 2, tiết 1-3\",\n            \"isInCurriculum\": true\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/classRegistrations",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations"]
            }
          }
        },
        {
          "name": "Update Class Registration",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/classRegistrations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations", ":id"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
        },
        {
          "name": "Delete Class Registration",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classRegistrations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations", ":id"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classRegistrations/stats?from=2025-01-01&to=2025-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations", "stats"],
              "query": [
                {"key": "from", "value": "2025-01-01"},
                {"key": "to", "value": "2025-01-31"}
              ]
            }
          }
        },
        {
          "name": "Preview Reply",
          "request": {
            "method": "GET",
