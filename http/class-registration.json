              "host": ["{{baseUrl}}"],
              "path": ["classRegistration", "classRegistrations"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "messageId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "messageStatuses[]",
                  "value": "",
                  "description": "new | staged | replied",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id",
                  "description": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
