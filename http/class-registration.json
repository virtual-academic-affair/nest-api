              "path": ["classRegistrations", ":id", "reply"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
        },
        {
          "name": "Send Reply",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"html\": \"<p>Your registration has been approved.</p>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/classRegistrations/:id/reply",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations", ":id", "reply"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
        }
      ]
