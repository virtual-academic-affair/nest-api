              "raw": "{{baseUrl}}/classRegistrations?page=1&limit=10&search=&studentCode=&academicYear=&status=&action=&orderBy=id&orderDir=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["classRegistrations"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "search", "value": "", "disabled": true},
                {"key": "studentCode", "value": "", "description": "Filter by student code", "disabled": true},
                {"key": "academicYear", "value": "", "description": "Filter by academic year (e.g., 2025)", "disabled": true},
                {"key": "status", "value": "", "description": "Filter by status: pending | approved | rejected", "disabled": true},
                {"key": "action", "value": "", "description": "Filter by action: register | cancel | requestOpen", "disabled": true},
                {"key": "orderBy", "value": "id"},
                {"key": "orderDir", "value": "DESC"}
              ]
            }
          }
        },
        {
