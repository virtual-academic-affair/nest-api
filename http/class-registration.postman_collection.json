{
  "info": {
    "name": "Class Registration",
    "description": "Test all class registration features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "registration_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "item_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('registration_id', response.id);",
              "    pm.collectionVariables.set('item_id', response.items[0].id);",
              "    console.log('Created registration ID:', response.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"messageId\": 1,\n  \"studentCode\": \"B21DCCN123\",\n  \"academicYear\": 2021,\n  \"studentName\": \"Nguyễn Văn A\",\n  \"items\": [\n    {\n      \"action\": \"REGISTER\",\n      \"subjectName\": \"Lập trình hướng đối tượng\",\n      \"className\": \"IT4062.E10\",\n      \"subjectCode\": \"IT4062\",\n      \"slotInfo\": \"Thứ 2, 6-7\",\n      \"isInCurriculum\": true\n    },\n    {\n      \"action\": \"CANCEL\",\n      \"subjectName\": \"Cấu trúc dữ liệu\",\n      \"className\": \"IT3011.E12\",\n      \"subjectCode\": \"IT3011\",\n      \"slotInfo\": \"Thứ 3, 1-3\",\n      \"isInCurriculum\": true\n    },\n    {\n      \"action\": \"REQUEST_OPEN\",\n      \"subjectName\": \"Trí tuệ nhân tạo\",\n      \"subjectCode\": \"IT4062\",\n      \"isInCurriculum\": false\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/class-registrations",
          "host": ["{{base_url}}"],
          "path": ["class-registrations"]
        },
        "description": "Create registration linked to a Message. messageId (required) phải tồn tại trong DB."
      }
    },
    {
      "name": "1b. Create Class Transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('registration_id', response.id);",
              "    pm.collectionVariables.set('item_id', response.items[0].id);",
              "    console.log('Created registration ID:', response.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"messageId\": 2,\n  \"studentCode\": \"B21DCCN456\",\n  \"academicYear\": 2021,\n  \"studentName\": \"Trần Thị B\",\n  \"items\": [\n    {\n      \"action\": \"CANCEL\",\n      \"subjectName\": \"Toán cao cấp\",\n      \"className\": \"MA1011.E11\",\n      \"subjectCode\": \"MA1011\",\n      \"slotInfo\": \"Thứ 2, 6-8\",\n      \"isInCurriculum\": true\n    },\n    {\n      \"action\": \"REGISTER\",\n      \"subjectName\": \"Toán cao cấp\",\n      \"className\": \"MA1011.E12\",\n      \"subjectCode\": \"MA1011\",\n      \"slotInfo\": \"Thứ 4, 1-3\",\n      \"isInCurriculum\": true\n    },\n    {\n      \"action\": \"REGISTER\",\n      \"subjectName\": \"Vật lý đại cương\",\n      \"className\": \"PH1011.E10\",\n      \"subjectCode\": \"PH1011\",\n      \"slotInfo\": \"Thứ 5, 6-8\",\n      \"isInCurriculum\": true\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/class-registrations",
          "host": ["{{base_url}}"],
          "path": ["class-registrations"]
        },
        "description": "Create registration with class transfer (Toán E11 → E12). Reply sẽ tự detect transfer."
      }
    },
    {
      "name": "2. Get All Registrations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["class-registrations"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "keyword",
              "value": "B21DCCN",
              "disabled": true
            },
            {
              "key": "studentCode",
              "value": "B21DCCN123",
              "disabled": true
            },
            {
              "key": "academicYear",
              "value": "2021",
              "disabled": true
            },
            {
              "key": "status",
              "value": "PENDING",
              "disabled": true,
              "description": "PENDING | APPROVED | REJECTED"
            },
            {
              "key": "action",
              "value": "REGISTER",
              "disabled": true,
              "description": "REGISTER | CANCEL | REQUEST_OPEN"
            },
            {
              "key": "orderBy",
              "value": "priority",
              "disabled": true
            }
          ]
        },
        "description": "Get list of all registrations with pagination and filters"
      }
    },
    {
      "name": "3. Get Registration by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/{{registration_id}}",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "{{registration_id}}"]
        },
        "description": "Get detailed information of a specific registration including all items"
      }
    },
    {
      "name": "4. Get Stats - Overview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/stats/overview",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "stats", "overview"]
        },
        "description": "Get overview statistics: total registrations, total/pending/approved/rejected items"
      }
    },
    {
      "name": "4b. Get Stats - Register",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/stats/register",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "stats", "register"]
        },
        "description": "Get statistics for REGISTER items only"
      }
    },
    {
      "name": "4c. Get Stats - Cancel",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/stats/cancel",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "stats", "cancel"]
        },
        "description": "Get statistics for CANCEL items only"
      }
    },
    {
      "name": "4d. Get Stats - Request Open",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/stats/request-open",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "stats", "request-open"]
        },
        "description": "Get statistics for REQUEST_OPEN items only"
      }
    },
    {
      "name": "5. Get Item by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration-items/{{item_id}}",
          "host": ["{{base_url}}"],
          "path": ["registration-items", "{{item_id}}"]
        },
        "description": "Get detailed information of a specific registration item"
      }
    },
    {
      "name": "6. Get Items by Registration ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration-items/by-registration/{{registration_id}}",
          "host": ["{{base_url}}"],
          "path": ["registration-items", "by-registration", "{{registration_id}}"]
        },
        "description": "Get all items belonging to a specific registration"
      }
    },
    {
      "name": "7. Process Item - Approve",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/registration-items/{{item_id}}/process",
          "host": ["{{base_url}}"],
          "path": ["registration-items", "{{item_id}}", "process"]
        },
        "description": "Approve a registration item (full update)"
      }
    },
    {
      "name": "8. Process Item - Reject",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectReason\": \"Lớp đã đầy\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/registration-items/{{item_id}}/process",
          "host": ["{{base_url}}"],
          "path": ["registration-items", "{{item_id}}", "process"]
        },
        "description": "Reject a registration item with reason (required for rejection)"
      }
    },
    {
      "name": "9. Process Bulk Items",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ids\": [1, 2, 3],\n  \"status\": {\n    \"status\": \"APPROVED\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/registration-items/process-bulk",
          "host": ["{{base_url}}"],
          "path": ["registration-items", "process-bulk"]
        },
        "description": "Process multiple items at once (approve/reject)"
      }
    },
    {
      "name": "10a. Preview Reply (Manual Mode)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations/{{registration_id}}/reply/preview",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "{{registration_id}}", "reply", "preview"]
        },
        "description": "Preview email content before sending. Returns: to, subject, greeting, summary, fullBody. User có thể sửa fullBody và gửi qua endpoint Send."
      }
    },
    {
      "name": "10b. Send Reply (Auto Mode)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"greeting\": \"Chào bạn,\\n\\nBộ phận quản lý đào tạo đã xem xét yêu cầu đăng ký môn học của bạn.\\n\\nVui lòng xem chi tiết bên dưới:\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/class-registrations/{{registration_id}}/reply",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "{{registration_id}}", "reply"]
        },
        "description": "Auto mode: Gửi greeting, hệ thống tự tạo nội dung email hoàn chỉnh với summary."
      }
    },
    {
      "name": "10c. Send Reply (Manual Mode)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullBody\": \"Chào bạn,\\n\\nNội dung email đã được chỉnh sửa bởi admin...\\n\\n(Copy từ preview và sửa theo ý muốn)\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/class-registrations/{{registration_id}}/reply",
          "host": ["{{base_url}}"],
          "path": ["class-registrations", "{{registration_id}}", "reply"]
        },
        "description": "Manual mode: Gửi fullBody đã được user chỉnh sửa (từ Preview endpoint)."
      }
    },
    {
      "name": "11. Get Cancel Reasons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/cancel-reasons?page=1&limit=20",
          "host": ["{{base_url}}"],
          "path": ["cancel-reasons"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get list of predefined cancel/reject reasons"
      }
    },
    {
      "name": "12. Get All by Priority",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/class-registrations?orderBy=priority&status=PENDING",
          "host": ["{{base_url}}"],
          "path": ["class-registrations"],
          "query": [
            {
              "key": "orderBy",
              "value": "priority",
              "description": "Sort by: academicYear ASC, isInCurriculum DESC, sentAt ASC"
            },
            {
              "key": "status",
              "value": "PENDING",
              "description": "Filter items by status"
            }
          ]
        },
        "description": "Get registrations sorted by priority: 1) SV năm cuối trước, 2) Môn trong CTDT trước, 3) Email gửi trước"
      }
    }
  ]
}
