{
  "info": {
    "name": "Email",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Messages",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "messages"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "description": "subject | senderEmail | senderName",
                  "disabled": true
                },
                {
                  "key": "systemLabels[]",
                  "value": "",
                  "description": "classRegistration | task | inquiry | other",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "sentAt",
                  "description": "sentAt"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "messages",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "sync",
          "request": {
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "messages",
                "sync"
              ]
            }
          }
        },
        {
          "name": "updateLabels",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"systemLabels\": [\"task\", \"inquiry\"]\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "messages",
                ":id",
                "labels"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Labels",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "labels"
              ]
            }
          }
        },
        {
          "name": "findAllGmailLabels",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "labels",
                "gmailLabels"
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"classRegistration\": \"Label_123\",\n    \"task\": \"Label_456\",\n    \"inquiry\": \"Label_789\",\n    \"other\": \"Label_000\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "labels"
              ]
            }
          }
        },
        {
          "name": "autoCreateLabels",
          "request": {
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "labels",
                "autoCreate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AllowedDomains",
      "item": [
        {
          "name": "get",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "allowedDomains"
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"domains\": [\"example.com\", \"test.com\"]\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "allowedDomains"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Grants",
      "item": [
        {
          "name": "getAuthUrl",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "grants"
              ]
            }
          }
        },
        {
          "name": "grant",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"code\": \"<google_oauth_code>\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "email",
                "grants"
              ]
            }
          }
        }
      ]
    }
  ]
}
