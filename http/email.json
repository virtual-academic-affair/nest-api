{
  "info": {
    "name": "Email",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Messages",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "messages"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "gmailMessageId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "threadId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "sentAt"
                },
                {
                  "key": "orderDir",
                  "value": "DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "messages", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "messages", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Labels",
      "item": [
        {
          "name": "findAllGmailLabels",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "labels", "gmailLabels"]
            }
          }
        },
        {
          "name": "autoCreateLabels",
          "request": {
            "method": "POST",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "labels", "autoCreate"]
            }
          }
        }
      ]
    },
    {
      "name": "Webhook",
      "item": [
        {
          "name": "gmail webhook",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"emailAddress\": \"example@gmail.com\",\n  \"historyId\": \"123456\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["email", "webhook"]
            }
          }
        }
      ]
    }
  ]
}
