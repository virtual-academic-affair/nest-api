{
  "info": {
    "name": "Inquiry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Inquiries",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "types[]",
                  "value": "",
                  "description": "graduation | training",
                  "disabled": true
                },
                {
                  "key": "messageId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "messageStatuses[]",
                  "value": "",
                  "description": "new | staged | replied",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "create",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"messageId\": 1,\n  \"messageStatus\": \"new\",\n  \"types\": [\"graduation\"],\n  \"question\": \"When is the graduation defense schedule?\",\n  \"answer\": \"The expected period is late June.\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries"]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"types\": [\"training\"],\n  \"question\": \"How do I submit training documents?\",\n  \"answer\": \"Please submit directly at the academic affairs office.\"\n}"
            },
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "stats",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", "stats"],
              "query": [
                {
                  "key": "from",
                  "value": "2024-01-01"
                },
                {
                  "key": "to",
                  "value": "2026-12-31"
                }
              ]
            }
          }
        },
        {
          "name": "reply",
          "request": {
            "method": "POST",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", ":id", "reply"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "previewReply",
          "request": {
            "method": "GET",
            "url": {
              "host": ["{{baseUrl}}"],
              "path": ["inquiry", "inquiries", ":id", "reply"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
