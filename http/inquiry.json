{
  "info": {
    "name": "Inquiry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Inquiries",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "messageId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "messageStatuses[]",
                  "value": "",
                  "description": "opened | replied | closed | resolved",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "id"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "create",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
              "raw": {
                "language": "json"
              }
            },
              "raw": "{\n    \"messageId\": 1,\n    \"types\": [\"graduation\"],\n    \"question\": \"Bao gio co lich bao ve?\",\n    \"answer\": \"Du kien cuoi thang 6\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries"
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"types\": [\"procedure\"],\n    \"question\": \"Cho em hoi thu tuc nop ho so?\",\n    \"answer\": \"Em nop tai phong giao vu\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "stats",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inquiry",
                "inquiries",
                "stats"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2025-01-01"
                },
                {
                  "key": "to",
                  "value": "2025-01-31"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
