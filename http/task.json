{
  "info": {
    "name": "Task",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "findAll",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "todo | doing | done | cancelled",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "",
                  "description": "low | medium | high | urgent",
                  "disabled": true
                },
                {
                  "key": "dueDateFrom",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "dueDateTo",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "assigneeIds",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "orderCol",
                  "value": "due",
                  "description": "due"
                },
                {
                  "key": "orderDir",
                  "value": "DESC",
                  "description": "ASC | DESC"
                }
              ]
            }
          }
        },
        {
          "name": "findOne",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "create",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"name\": \"Du an website moi\",\n    \"description\": \"Thiet ke va lap trinh frontend cho website\",\n    \"due\": \"2025-12-31T23:59:59Z\",\n    \"priority\": \"high\",\n    \"status\": \"todo\",\n    \"assigners\": [\"Khoa CNTT\"],\n    \"messageId\": 1\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks"
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"status\": \"doing\",\n    \"priority\": \"urgent\",\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "stats",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                "stats"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2025-01-01"
                },
                {
                  "key": "to",
                  "value": "2025-01-31"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "TaskItems",
      "item": [
        {
          "name": "create",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"name\": \"Task item name\",\n    \"assigneeId\": 1,\n    \"note\": \"Some note\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":parentId",
                "items"
              ],
              "variable": [
                {
                  "key": "parentId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "update",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"isChecked\": true,\n    \"name\": \"Updated name\",\n    \"assigneeId\": 1,\n    \"note\": \"Updated note\"\n}"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":parentId",
                "items",
                ":id"
              ],
              "variable": [
                {
                  "key": "parentId",
                  "value": "1"
                },
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "remove",
          "request": {
            "method": "DELETE",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "tasks",
                ":parentId",
                "items",
                ":id"
              ],
              "variable": [
                {
                  "key": "parentId",
                  "value": "1"
                },
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
