{
    "info": {
        "name": "Labels",
        "description": "API collection for Labels",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Get All Gmail Labels",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/email/labels/gmailLabels",
                    "host": ["{{baseUrl}}"],
                    "path": ["email", "labels", "gmailLabels"]
                }
            }
        },
        {
            "name": "Get All Labels",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/email/labels",
                    "host": ["{{baseUrl}}"],
                    "path": ["email", "labels"]
                }
            }
        },
        {
            "name": "Update Labels",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"classRegistration\": \"<gmail_label_id>\",\n    \"task\": \"<gmail_label_id>\",\n    \"inquiry\": \"<gmail_label_id>\",\n    \"other\": \"<gmail_label_id>\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/email/labels",
                    "host": ["{{baseUrl}}"],
                    "path": ["email", "labels"]
                }
            }
        },
        {
            "name": "Auto Create Labels",
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/email/labels/autoCreate",
                    "host": ["{{baseUrl}}"],
                    "path": ["email", "labels", "autoCreate"]
                }
            }
        }
    ]
}
