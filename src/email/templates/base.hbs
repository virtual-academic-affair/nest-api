<body style="background-color: #ffffff; padding: 24px; margin: 0; -webkit-font-smoothing: antialiased; font-family: 'system-ui', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 40px;">
    <img src="{{emailLogoUrl}}" alt="Logo" style="display: block; height: 40px; width: auto; border: 0;"/>
  </div>

  <h1 style="font-size: 32px; font-weight: 600; color: #111827; margin-bottom: 50px; letter-spacing: -0.02em;">
    {{title}}
  </h1>

  <div style="font-size: 14px; line-height: 1.8; color: #374151; margin-bottom: 40px;">
    {{{content}}}
  </div>

  <footer style="font-size: 14px; color: #9ca3af; border-top: 1px solid #f3f4f6; padding-top: 24px;">
    Tran trong, <br>
    <span style="display: block; margin-top: 4px;">
      <a href="{{appUrl}}" style="font-weight: 700; color: #4b5563; text-decoration: none;">
        {{appName}}
      </a>
    </span>
  </footer>
</div>
</body>
