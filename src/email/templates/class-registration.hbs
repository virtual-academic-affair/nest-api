<div style='color: #374151; margin-bottom: 24px;'>
  <p style='margin: 4px 0;'><strong>Họ tên:</strong> {{studentName}} </p>
  <p style='margin: 4px 0;'><strong>MSSV:</strong> {{studentCode}} </p>
</div>

<div style='margin: 4px 0;'>{{{note}}}</div>

{{#if hasItems}}
  <h3 style='color: #1F2937; font-weight: bold; margin-bottom: 16px; letter-spacing: 0.025em; font-size: 21px'>Danh sách
    đăng ký học phần</h3>
  <div style='overflow-x: auto;'>
    <table style='width: 100%; border-collapse: collapse; table-layout: fixed;'>
      <thead>
        <tr style='border-bottom: 1px solid #000000;'>
          <th style='text-align: center; width: 40px; padding-bottom: 4px;'>#</th>
          <th style='text-align: center; width: 120px; padding-bottom: 4px;'>Mã môn</th>
          <th style='text-align: center; width: 260px; padding-bottom: 4px;'>Lớp</th>
          <th style='text-align: center; width: 140px; padding-bottom: 4px;'>Nguyện vọng</th>
          <th style='text-align: center; width: 112px; padding-bottom: 4px;'>Kết quả</th>
          <th style='text-align: center; width: 200px; padding-bottom: 4px;'>Ghi chú</th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
          <tr style='border-bottom: 1px solid #F3F4F6; color: #000000;'>
            <td style='padding: 12px; text-align: center; color: #9CA3AF; width: 40px;'>{{item.displayIndex}}</td>
            <td style='padding: 12px; width: 120px; text-align: center;'>{{item.subjectCode}}</td>
            <td style='padding: 12px; width: 260px;'>{{item.subjectName}} - {{item.className}}</td>
            <td style='padding: 12px; width: 140px; text-align: center;'>{{item.actionLabel}}</td>
            <td style='padding: 12px; white-space: nowrap; width: 112px; text-align: center;'>
              <span
                style='width: 80px; font-size: 11px; display: inline-block; padding: 2px; border-radius: 9999px; font-weight: 500; background-color: {{item.statusBg}}; color: {{item.statusColor}};'
              >
                {{item.statusLabel}}
              </span>
            </td>
            <td style='padding: 12px; width: 200px;'>
              {{{item.note}}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div style='margin-top: 16px;'>
    Sinh viên vui lòng truy cập portal để kiểm tra lại thông tin kết quả đăng ký học phần
    <a
      href='https://portal.ctdb.hcmus.edu.vn/sinh-vien/ket-qua-dkhp'
      style='font-style: normal; font-weight: bold; color: #4B5563; text-decoration: none;'
    >
      tại đây
    </a>
  </div>
{{/if}}