<div style='color: #374151; margin-bottom: 24px;'>
  <p style='margin: 4px 0;'><strong>Họ tên:</strong> {{studentName}} </p>
  <p style='margin: 4px 0;'><strong>MSSV:</strong> {{studentCode}} </p>
</div>

<div style='margin: 4px 0;'>{{{note}}}</div>

{{#if hasItems}}
  <h3 style='color: #1F2937; font-weight: bold; margin-bottom: 16px; letter-spacing: 0.025em; font-size: 21px'>Danh sách
    đăng ký học phần</h3>
  <div style='overflow-x: auto;'>
    <table style='width: 100%; border-collapse: collapse; table-layout: fixed;'>
      <colgroup>
        <col style='width: 44px;' />
        <col />
        <col style='width: 132px;' />
        <col style='width: 118px;' />
        <col style='width: 112px;' />
      </colgroup>
      <thead>
        <tr style='border-bottom: 1px solid #000000;'>
          <th style='text-align: center; vertical-align: bottom; padding: 12px 8px 8px 8px;'>#</th>
          <th style='text-align: left; vertical-align: bottom; padding: 12px 12px 8px 12px;'>Môn học</th>
          <th style='text-align: center; vertical-align: bottom; padding: 12px 8px 8px 8px;'>Lớp</th>
          <th style='text-align: center; vertical-align: bottom; padding: 12px 8px 8px 8px;'>Nguyện vọng</th>
          <th style='text-align: center; vertical-align: bottom; padding: 12px 8px 8px 8px;'>Kết quả</th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
          <tr style='border-bottom: 1px solid #F3F4F6; color: #000000;'>
            <td
              style='padding: 12px 8px; text-align: center; vertical-align: top; color: #9CA3AF;'
            >{{item.displayIndex}}</td>
            <td
              style='padding: 12px; text-align: left; vertical-align: top; word-break: break-word;'
            >{{item.subjectLine}}</td>
            <td style='padding: 12px 8px; text-align: center; vertical-align: top;'>{{item.className}}</td>
            <td style='padding: 12px 8px; text-align: center; vertical-align: top;'>{{item.actionLabel}}</td>
            <td style='padding: 12px 8px; white-space: nowrap; text-align: center; vertical-align: top;'>
              <span
                style='width: 80px; font-size: 11px; display: inline-block; padding: 2px; border-radius: 9999px; font-weight: 500; background-color: {{item.statusBg}}; color: {{item.statusColor}};'
              >
                {{item.statusLabel}}
              </span>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div style='margin-top: 16px;'>
    Sinh viên vui lòng truy cập portal để kiểm tra lại thông tin kết quả đăng ký học phần
    <a
      href='https://portal.ctdb.hcmus.edu.vn/sinh-vien/ket-qua-dkhp'
      style='font-style: normal; font-weight: bold; color: #4B5563; text-decoration: none;'
    >
      tại đây
    </a>
  </div>
{{/if}}